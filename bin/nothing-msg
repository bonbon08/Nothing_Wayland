#!/usr/bin/env python3
"""Send a command to nothing-wm, e.g.:  nothing-msg action launcher | nothing-msg ws 2 | nothing-msg state"""
import os, socket, sys

path = os.environ.get("NOTHING_WM_SOCK")
if not path:
    sys.exit("NOTHING_WM_SOCK is not set (not running inside nothing-wm?)")
if len(sys.argv) < 2:
    sys.exit(__doc__)
s = socket.socket(socket.AF_UNIX)
s.connect(path)
s.sendall((" ".join(sys.argv[1:]) + "\n").encode())
if sys.argv[1] in ("state",):
    print(s.recv(1 << 20).decode().strip())
