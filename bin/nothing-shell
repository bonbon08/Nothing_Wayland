#!/bin/sh
# Start the Nothing shell. gtk4-layer-shell must be loaded before libwayland-client.
here="$(dirname "$(readlink -f "$0")")"
for d in "$here/../shell" "$here/../share/nothing-de/shell" /usr/local/share/nothing-de/shell /usr/share/nothing-de/shell; do
    [ -d "$d/nothing_de" ] && { PYTHONPATH="$d${PYTHONPATH:+:$PYTHONPATH}"; break; }
done
export PYTHONPATH
if [ -z "$NOTHING_NO_PRELOAD" ]; then
    for lib in /usr/lib/libgtk4-layer-shell.so /usr/lib64/libgtk4-layer-shell.so /usr/local/lib/libgtk4-layer-shell.so ${NOTHING_LAYER_SHELL_LIB:-}; do
        [ -e "$lib" ] && LAYER_LIB="$lib"
    done
    [ -n "$LAYER_LIB" ] && export LD_PRELOAD="$LAYER_LIB${LD_PRELOAD:+:$LD_PRELOAD}"
fi
exec python3 -m nothing_de.shell "$@"
